SECRET_KEY=

# False locally, True on the droplet. Drives DEBUG, ALLOWED_HOSTS,
# and the secure-cookie / HSTS / SSL-redirect settings.
IS_PROD=False

# The public domain. Single source of truth for both Django and Caddy:
#   blank (local) -> ALLOWED_HOSTS=localhost, Caddy serves plain HTTP
#   set   (prod)  -> ALLOWED_HOSTS + CSRF_TRUSTED_ORIGINS, Caddy provisions HTTPS
SITE_DOMAIN=

# Cloudflare Turnstile, on the public prayer form only.
#

#   2x00000000000000000000AB / 2x0000000000000000000000000000000AA = always fail
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
