# Copy to .env and fill in real values. .env is gitignored.

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# False locally, True on the droplet. Drives DEBUG, ALLOWED_HOSTS,
# and the secure-cookie / HSTS / SSL-redirect settings.
IS_PROD=False

# The public domain, used for ALLOWED_HOSTS in prod. Leave blank locally.
SITE_DOMAIN=
